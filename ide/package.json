{
  "name": "claide-ide",
  "productName": "Claide IDE",
  "version": "0.2.0",
  "description": "Write, run and preview Claide websites. Python runs inside the app.",
  "author": "kurodaki-dev",
  "license": "MIT",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "build": "node build.mjs",
    "start": "npm run build && electron .",
    "dist:win": "npm run build && electron-builder --win --publish never",
    "dist:linux": "npm run build && electron-builder --linux --publish never",
    "android:sync": "npm run build && cap sync android",
    "android:add": "npm run build && cap add android && node scripts/android-fullscreen.mjs"
  },
  "devDependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/cli": "^8.6.0",
    "@capacitor/core": "^8.6.0",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lezer/highlight": "^1.2.5",
    "codemirror": "^6.0.2",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "pyodide": "^314.0.7"
  },
  "build": {
    "appId": "io.github.kurodaki.claide",
    "productName": "Claide IDE",
    "artifactName": "Claide-IDE-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "release",
      "buildResources": "resources"
    },
    "files": [
      "dist/**",
      "electron/**",
      "resources/icon.png",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "resources/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Claide-IDE-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "Claide-IDE-${version}-portable.${ext}"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Development",
      "icon": "resources/icon.png",
      "maintainer": "kurodaki-dev <kurodaki-dev@users.noreply.github.com>",
      "synopsis": "Write, run and preview Claide websites"
    },
    "publish": null
  },
  "homepage": "https://kurodaki-dev.github.io/Claide/"
}
